# Dependencies
node_modules/

# Builds
packages/shared/lib/
functions/lib/
app/dist-web/
app/.expo/
# The iOS archive and export (`npx sabeel-ci build-ios`).
/build/
# The build stamp, written at every build by `sabeel-ci build-info`; committed,
# it would mark every build as made from uncommitted changes.
app/src/build-info.ts

# Firebase
.firebase/
firebase-debug.log
firestore-debug.log
storage-debug.log
ui-debug.log
pubsub-debug.log

# Google services file is per-project and carries the OAuth client ids —
# regenerated from the console, never committed.
# google-services.json carries the Android OAuth client + FCM sender — per-project
# config, regenerated from the Firebase console, never committed. Both the Expo
# source location and the Gradle location.
**/google-services.json
# GoogleService-Info.plist is its iOS twin (the iOS OAuth client, its
# REVERSED_CLIENT_ID URL scheme, the FCM sender): same rule.
**/GoogleService-Info.plist

# Env / local secrets (client DSNs etc. — names only in docs/SECRETS.md)
.env
.env.local
*.local.env
functions/.env

# Never commit a binary: per-release APKs bloated the sibling pages repo's
# history and had to be rewritten out. The APK ships as a GitHub Release asset.
*.apk
*.aab

# Screenshots and logs of the browser and device suites
shots/

# Logs & misc
*.log
.DS_Store
# The build machine's Sentry auth token, Apple team id and App Store Connect
# key ids, which the Android and iOS release builds read. Real secrets.
.env.sentry-build-plugin
app/.env.sentry-build-plugin
# Sentry's tools also take a token from a sentry.properties file; this app
# keeps none there, and one is never committed.
**/sentry.properties
functions/.secret.local
**/.secret.local

# Plaintext Zoom creds a human dropped in — creds live in Secret Manager, never here.
zoom-api-info.txt

# Regenerated fixtures and scratch output (never committed)
.tmp/

# Metro transform cache, kept in-repo (see app/metro.config.js)
app/.metro-cache/

# Python bytecode from the help films' scripts (scripts/tutorials)
__pycache__/

# Generated by `expo prebuild --platform ios` on the Mac; a build product, not
# hand-edited and not committed. Everything that must persist is in app/app.json
# (docs/IOS-BUILD.md).
app/ios/
gha-creds-*.json
app/android/keystore.properties

# Signing and service-account keys: one committed to this public repository
# stays readable in its history. The debug keystore ships with every Android
# SDK, so it is no secret, and Gradle signs debug builds with it.
*.jks
*.keystore
!app/android/app/debug.keystore
*service-account*.json
*firebase-adminsdk*.json
