rules_version = '2';

// Deny by default. The backend (Cloud Functions, Admin SDK) bypasses all rules;
// clients get only the narrow paths spelled out below.
//
// Role and status live in CUSTOM CLAIMS, set exclusively by Cloud Functions. The
// user documents mirror them so the UI can render a name and a state. The token
// is what these rules trust, and a stale or tampered mirror never grants
// anything: staff need the token AND their staff record to agree, so the
// record can only take away. Every predicate reads request.auth.token, plus that
// one record for staff, never resource.data.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Domain membership, and even a successful Google sign-in, grant NOTHING on
    // their own — an admin has to approve the account. Default '' so a claimless
    // token (a brand-new account, or one the auth trigger is about to delete)
    // fails every check.
    function isActive() {
      return isSignedIn() && request.auth.token.get('status', '') == 'active';
    }

    function role() {
      return request.auth.token.get('role', '');
    }

    /*
     * THE STAFF RECORD STILL SAYS SO. A token keeps its claims until it expires,
     * up to an hour, and these rules cannot ask whether it was revoked. On the
     * claim alone, a manager disabled a minute ago, or an admin just made a
     * manager, went on reading every student's name and address for the rest of
     * that hour. `setStaffAccess` writes the staff record as part of the change,
     * so asking it too ends both at once. Only a token with a staff role gets
     * this far, so students never pay for the read.
     */
    function staffRecordAgrees() {
      let rec = get(/databases/$(database)/documents/staffUsers/$(request.auth.uid)).data;
      return rec.status == 'active' && rec.role == role();
    }

    function isStaff() {
      return isActive() && role() in ['manager', 'admin'] && staffRecordAgrees();
    }

    // Admins alone approve staff, change roles, and manage student access.
    function isAdmin() {
      return isActive() && role() == 'admin' && staffRecordAgrees();
    }

    /*
     * A TIME A CLIENT WRITES, in milliseconds: a real moment, bounded
     * absolutely rather than against request.time, so a phone whose clock
     * runs fast still saves. A JavaScript Date holds far more, but a staff
     * screen or export formats these, and a time past year 9999 formats as
     * text no date parser reads back, or throws: one student's row blanked
     * their class's progress page and its workbook. The bound is
     * LATEST_CLIENT_TIME in @sabeel/shared; rules.recordings.test.ts holds
     * the two together.
     */
    function isTime(v) {
      return v is int && v > 0 && v < 4102444800000;
    }

    function isStudent() {
      return isActive() && role() == 'student';
    }

    /*
     * A STUDENT WHO WRITES IS ONE WHOSE RECORD STILL SAYS SO, as staff are
     * (`staffRecordAgrees`). A token keeps its claims for up to an hour, and a
     * student disabled a minute ago went on marking recordings complete on
     * their class's ledger for the rest of it. Writes only: reading their own
     * work for that hour shows them nothing new, and every read a student
     * makes would otherwise pay for this one.
     */
    function isWritingStudent() {
      return isStudent()
        && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.status == 'active';
    }

    // Staff who may see one class's data: an admin (reads nothing), or a manager
    // assigned to that class. The per-row get() means a query using this must be
    // constrained to a single class — the same affordability rule as /assignments
    // and /enrollments. Introduced for the Phase 5 ledger reads.
    function staffManagesCourse(courseId) {
      return isAdmin()
        || (isStaff() && request.auth.uid in
            get(/databases/$(database)/documents/courses/$(courseId)).data.managerUids);
    }

    /*
     * The class a student's own grant for one recording belongs to.
     *
     * The three collections a student writes — listening progress, completion
     * state, completion events — all carry a `courseId`, and every staff read of
     * them is `courseId == && recordingId ==` because the rules require it. So
     * `courseId` is not decoration: a row carrying the wrong one is a row the
     * ledger never sees, while the student's own screens (filtered on
     * `studentUid` alone) go on showing it. The grant is the only thing that can
     * say which class a recording was owed in, so the grant is what it is
     * checked against.
     *
     * One `get`, on a path built from the caller's own uid — so it is one
     * distinct path per request and stays well inside the ten-call budget.
     */
    function grantedCourse(recordingId) {
      return get(/databases/$(database)/documents/assignments/$(request.auth.uid + '_' + recordingId)).data.courseId;
    }
    /*
     * AND THE GRANT IS ACTIVE. A grant lapses — corrected to present after all,
     * unenrolled, unpublished — by being switched off, never deleted, so a
     * check on its class alone accepted rows from students who no longer held
     * the recording; they surfaced on the ledger as ticks for people the
     * class was closed to. The same document as `grantedCourse`, so the same
     * one read — Firestore caches a path within a request.
     */
    function holdsGrant(recordingId) {
      return get(/databases/$(database)/documents/assignments/$(request.auth.uid + '_' + recordingId)).data.active == true;
    }

    // ---- Staff ----
    // Read-only to clients; every write goes through the setStaffAccess
    // callable. Role and status ARE the security model, so letting clients write
    // any field of their own staff document would mean every field added here
    // later needs re-auditing to be sure it is not privilege-adjacent. Denying
    // writes outright means that audit can never be forgotten.
    match /staffUsers/{uid} {
      // Your own document, readable even while pending, so the gate screen can
      // show your status and update the moment an admin approves you.
      allow get: if isSignedIn() && request.auth.uid == uid;
      // Staff see the roster; admins run the approval queue from it. Both need a
      // name and an address to know who they are looking at.
      allow get, list: if isStaff();
      allow write: if false;
    }

    // ---- Students ----
    // Staff manage students; a student may read only their own record.
    // Deliberately no self-write: a student renaming themselves would alter the
    // accountability record staff rely on.
    //
    // The directory is readable by ALL staff, not only a manager's own courses
    // (Faisal, 2026-07-21). That is what makes "enrol an existing student into
    // my class" possible at all. Scoping it would also need a per-row class
    // lookup — the same document-access-limit problem documented on
    // /enrollments below. Every student MUTATION is still scoped or admin-only.
    // This is a deliberate privacy call, not an oversight; do not "fix" it.
    match /students/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow get, list: if isStaff();
      allow write: if false;
    }

    // ---- Cohorts ----
    // No scoping concept at cohort level: a manager scoped to a class inside a
    // cohort necessarily sees that cohort's name. Mutation is admin-only, via
    // callables.
    match /cohorts/{cohortId} {
      allow get, list: if isStaff();
      allow write: if false;
    }

    // ---- Coursees ----
    match /courses/{courseId} {
      // The admin arm reads no documents, so an admin lists every class freely.
      // The manager arm depends on resource.data, and THAT is what forces a
      // manager's query to carry where('managerUids','array-contains',uid) —
      // Firestore rejects a list it cannot prove is constrained. A comment
      // saying "managers must constrain their query" would enforce nothing.
      allow get, list: if isAdmin()
        || (isStaff() && request.auth.uid in resource.data.managerUids);

      // A student reads a class only through their own ACTIVE enrollment. The
      // path is built from the PATH SEGMENT courseId plus their own uid, never
      // from document data, so it costs one call on a get. Students never LIST
      // courses — they list their enrollments and then get each class.
      //
      // Active, not merely present: unenrolment keeps the row (history
      // survives), so `exists()` alone let a student removed from a class go
      // on reading it for good. One `get` on the same path the `exists()`
      // used, so the budget is unchanged.
      allow get: if isStudent()
        && get(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + courseId)).data.active == true;

      allow write: if false;
    }

    // ---- Enrollments ----
    // Document id is `${studentUid}_${courseId}`.
    match /enrollments/{enrollmentId} {
      // The staff arm resolves a class get() FROM EACH ROW'S DATA. Firestore caps
      // document-access calls per query, so that arm is only affordable when
      // every row resolves the same path — which a roster query
      // (where courseId == X) guarantees, and nothing else does.
      //
      // What keeps a student's cross-class query cheap is the `isStaff() &&`
      // guard, not the order of the arms: `&&` short-circuits, so a student
      // token never evaluates the get() at all. Verified by reordering the arms
      // and re-running the 25-row scale tests in rules.structure.test.ts — they
      // stay green either way. Read-free arms are still written first as
      // defence in depth and to match the sibling kanban app's card rule, but do
      // not rely on ordering alone: keep every read-requiring arm behind a role
      // guard that excludes the population whose queries span many parents.
      //
      // An unconstrained enrollments list by a manager exceeds the limit and
      // fails closed, which is the correct outcome.
      allow get, list: if (isStudent() && resource.data.studentUid == request.auth.uid)
        || isAdmin()
        || (isStaff() && request.auth.uid in
            get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.managerUids);

      allow write: if false;
    }

    // ---- Recordings ----
    match /recordings/{recordingId} {
      // Same discipline as /courses and /enrollments: the admin arm reads no
      // documents, and the staff arm depends on resource.data, which is what
      // forces a staff query to be constrained. That arm resolves a course
      // lookup per row, cached per distinct path, so it is affordable only for a
      // query over a SMALL, BOUNDED set of courseIds — one for most staff lists,
      // and at most `QUEUE_SCOPE.manager` for the work queue. That ceiling is
      // Firestore's ten document-access calls per query request, and the
      // emulator does not enforce it: see the note on QUEUE_SCOPE itself.
      allow get, list: if isAdmin()
        || (isStaff() && request.auth.uid in
            get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.managerUids);

      // A student reads a recording only through their own ASSIGNMENT — the
      // document created because they were marked excused. Enrolment grants
      // nothing on its own: a student who attended, or who was absent without
      // being excused, has no assignment and therefore no recording.
      //
      // GET ONLY, deliberately. The assignment path is built from the PATH
      // SEGMENT recordingId plus their own uid, so on a get it costs a fixed two
      // calls; on a LIST it would cost two PER ROW and blow the per-query
      // document-access cap. Students have no reason to list recordings — they
      // list their own assignments, which needs no reads at all, and get each
      // recording from that.
      //
      // The exists() is load-bearing, not defensive: get() on a document that
      // does not exist yields a null resource, and dereferencing it is an
      // evaluation ERROR, which refuses the read rather than answering it. The
      // usual case here IS absence, so without the guard every student would
      // trip an error instead of a clean denial.
      allow get: if isStudent()
        && resource.data.status == 'published'
        && exists(/databases/$(database)/documents/assignments/$(request.auth.uid + '_' + recordingId))
        && get(/databases/$(database)/documents/assignments/$(request.auth.uid + '_' + recordingId)).data.active == true;

      // Every mutation goes through a callable that re-checks course scope and
      // the lifecycle state machine.
      allow write: if false;
    }

    // ---- Attendance records ----
    // Document id is `${studentUid}_${sessionId}`. Each student's own copy of
    // their mark for one session, projected server-side from the session's
    // attendance map.
    //
    // It exists because Firestore security is per-document: there is no rule
    // that shows a student their own key of `session.attendance` and hides the
    // rest of the roster, so the only way to answer "was I marked present?" is a
    // document that says so and nothing else. The session stays canonical and
    // staff-only; this is derived from it and never written by a client.
    //
    // Read shape follows /assignments exactly: a student lists their own
    // (constrained by studentUid), an admin reads with no document lookups, a
    // manager resolves one course get() per row so their query must be scoped to
    // a course.
    match /attendanceRecords/{recordId} {
      allow get, list: if (isStudent() && resource.data.studentUid == request.auth.uid)
        || isAdmin()
        || (isStaff() && request.auth.uid in
            get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.managerUids);

      allow write: if false;
    }

    // ---- Sessions ----
    // A dated meeting: attendance lives here. Staff-only — students never read a
    // session or who attended (that is what makes attendance private). Managers
    // are scoped to their own courses; the admin arm reads no documents.
    //
    // The manager arm resolves a course lookup per row, cached per distinct
    // path, so a manager query has to span a bounded set of courses. The widest
    // one the app sends is the staff work queue's — `QUEUE_SCOPE.manager` ids in
    // one `in` clause, one document-access call each against Firestore's ten.
    // `rules.sessions.test.ts` sends exactly that query at exactly that width;
    // read the note on QUEUE_SCOPE for what that test can and cannot prove.
    match /sessions/{sessionId} {
      allow get, list: if isAdmin()
        || (isStaff() && request.auth.uid in
            get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.managerUids);
      allow write: if false;
    }

    // ---- Listening progress ----
    // Document id is `${studentUid}_${recordingId}`.
    match /listeningProgress/{progressId} {
      // ONE OF THE FEW CLIENT-WRITTEN COLLECTIONS, and the first — the others
      // are `bookmarks`, `completions` and `completionEvents` below, a
      // student's drafts, and their own device registrations. All of them
      // belong to a STUDENT and grant nothing; every structural write is
      // still a callable. The exception needs its reason
      // recorded: a callable every 15 seconds per listening student is pure
      // overhead, and the stakes are low. Listened time is audit
      // EVIDENCE, not the gate — completion is student-attested and blocked
      // only if the student never played, so inflating this gains nothing that
      // letting the audio run would not.
      //
      // Everything privilege-adjacent is still denied: a student can only touch
      // their own row, and cannot change whose it is.
      // THE DOCUMENT ID IS PART OF THE RULE, not just a convention the client
      // happens to follow. Without this a student could create
      // `<someone else's uid>_<recordingId>` carrying their OWN uid in the body:
      // the create passes (`studentUid` is honestly theirs), and the rightful
      // owner's first write is then an UPDATE whose `resource.data.studentUid`
      // is somebody else — denied from every device, for ever, with
      // `delete: if false` leaving no way back. A row that grants the writer
      // nothing, and permanently silences another student.
      function mine() {
        return isWritingStudent()
          && request.resource.data.studentUid == request.auth.uid
          && progressId == request.resource.data.studentUid + '_'
              + request.resource.data.recordingId;
      }
      /*
       * SHAPED, like every other client-written document. "Inflating this gains
       * nothing" is true of the VALUES; it says nothing about the types. A row
       * whose `updatedAt` was a string reached every staff screen that formats
       * it — `Intl.DateTimeFormat` throws on an invalid date, there is no error
       * boundary, and the recording ledger for that class went blank for every
       * manager and admin who opened it. Integers only, and only these keys.
       */
      function progressShape() {
        let d = request.resource.data;
        return d.keys().hasOnly(
              ['studentUid', 'recordingId', 'courseId', 'listenedMs', 'sittings', 'sitting', 'updatedAt'])
          && d.listenedMs is int && d.listenedMs >= 0
          && isTime(d.updatedAt)
          // EACH SITTING'S LISTENING, added up for `listenedMs` (`withSitting`
          // in @sabeel/shared). A save names its sitting and changes that
          // entry and no other, so every entry was checked as a number when
          // it was written. At most MAX_SITTINGS (500) of them.
          && d.sitting is string && d.sitting.size() > 0 && d.sitting.size() <= 40
          && d.sittings is map && d.sittings.size() <= 500
          && d.sittings[d.sitting] is int && d.sittings[d.sitting] >= 0
          && (resource == null
              ? d.sittings.keys().hasOnly([d.sitting])
              : d.sittings.diff(resource.data.sittings).affectedKeys().hasOnly([d.sitting]));
      }

      // `resource` is NULL when the document does not exist, and dereferencing
      // it then is a rules evaluation error — not a denial. That is what a
      // first-time listener hits, because resume reads the progress document
      // before anything has ever written one.
      //
      // BOUND TO THE CALLER'S OWN ID. `resource == null` on its own answers
      // about ANY id, and these are `${uid}_${recordingId}` — so
      // absent-is-allowed against present-is-denied would tell one student
      // whether a named classmate had ever played a named recording.
      allow get: if (isStudent()
          && (resource == null
                ? progressId.split('_')[0] == request.auth.uid
                : resource.data.studentUid == request.auth.uid))
        || (resource != null && staffManagesCourse(resource.data.courseId));
      // A list always evaluates against real documents, so no guard is needed —
      // and adding one would widen it. Staff read it for the ledger's
      // listened-% / last-listened columns, class-scoped.
      allow list: if (isStudent() && resource.data.studentUid == request.auth.uid)
        || staffManagesCourse(resource.data.courseId);

      /*
       * AND THE CLASS IS THE GRANT'S, not the writer's to choose.
       *
       * Every staff read of this collection is `courseId == && recordingId ==`
       * — the rules require it — so a row carrying the wrong `courseId` is a row
       * the ledger never sees: the manager's list counts that student as not
       * listened while the student's own screens, which filter on `studentUid`
       * alone, show their real progress. Nothing reconciles the two.
       *
       * The `get` is paid on CREATE only. Progress is rewritten every fifteen
       * seconds for the length of a lecture, and an update that may not move
       * `courseId` is free — so the class is fixed once, when the row is born.
       */
      allow create: if mine() && progressShape()
        && holdsGrant(request.resource.data.recordingId)
        && request.resource.data.courseId == grantedCourse(request.resource.data.recordingId);
      // Three things matter: `mine()` stops a student writing someone else's uid
      // into the row, the studentUid check stops them overwriting a row that is
      // already someone else's, and the courseId check stops them moving a row
      // out of the class its grant belongs to. The grant is checked on update
      // too: a row born under a live grant must not go on growing after the
      // grant was switched off — one read, the same path as on create.
      allow update: if mine() && progressShape()
        && resource.data.studentUid == request.auth.uid
        && request.resource.data.courseId == resource.data.courseId
        && holdsGrant(request.resource.data.recordingId);
      allow delete: if false;
    }

    // ---- Bookmarks ----
    // Document id is `${studentUid}_${recordingId}`. A student's one place to
    // come back to in a recording, on any device: where a recording reopens
    // is each device's own, and this is how a student takes their place to
    // another one. The student's alone: nobody else reads it, staff included.
    match /bookmarks/{bookmarkId} {
      // Bound to the id, as progress is: a bookmark planted under another
      // student's id would lock them out of their own.
      function mine() {
        return isWritingStudent()
          && request.resource.data.studentUid == request.auth.uid
          && bookmarkId == request.resource.data.studentUid + '_'
              + request.resource.data.recordingId;
      }
      function bookmarkShape() {
        let d = request.resource.data;
        return d.keys().hasOnly(['studentUid', 'recordingId', 'courseId', 'itemId', 'positionMs', 'setAt'])
          && d.itemId is string && d.itemId.size() > 0 && d.itemId.size() <= 64
          && d.positionMs is int && d.positionMs >= 0
          && isTime(d.setAt);
      }
      // A recording with no bookmark is read too, as its player opens:
      // bound to the caller's own id, as progress's `get` is.
      allow get: if isStudent()
        && (resource == null
              ? bookmarkId.split('_')[0] == request.auth.uid
              : resource.data.studentUid == request.auth.uid);
      // Set only in a recording the student holds, and filed under its class.
      allow create: if mine() && bookmarkShape()
        && holdsGrant(request.resource.data.recordingId)
        && request.resource.data.courseId == grantedCourse(request.resource.data.recordingId);
      allow update: if mine() && bookmarkShape()
        && resource.data.studentUid == request.auth.uid
        && request.resource.data.courseId == resource.data.courseId
        && holdsGrant(request.resource.data.recordingId);
      allow list, delete: if false;
    }

    // ---- Assignments ----
    // Document id is `${studentUid}_${recordingId}`. The grant itself — both the
    // permission to play a recording and the obligation to. Written ONLY by the
    // server (the fan-out trigger and the callables), so every client write is
    // denied; /recordings above reads it to decide whether a student may see a
    // recording at all, which is why a client-writable one would hand out
    // access. Reads follow the same read-free-arm-first, resource.data-
    // constrained discipline as /enrollments — a student lists their own
    // (constrained by studentUid), a manager reads their courses' (one class
    // get() per row, affordable only for a query scoped to a class).
    match /assignments/{assignmentId} {
      // A student's own grant that does not exist reads as absent: a recording
      // opened with no grant (an old link, a shared device) is not theirs to
      // play, which is an answer, not a refused listener. Bound to their own
      // id, as `listeningProgress` is, so it tells nobody whether a classmate
      // holds one.
      allow get: if (isStudent()
          && (resource == null
                ? assignmentId.split('_')[0] == request.auth.uid
                : resource.data.studentUid == request.auth.uid))
        || isAdmin()
        || (isStaff() && request.auth.uid in
            get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.managerUids);
      allow list: if (isStudent() && resource.data.studentUid == request.auth.uid)
        || isAdmin()
        || (isStaff() && request.auth.uid in
            get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.managerUids);
      allow write: if false;
    }

    // ---- Assignments (coursework) ----
    // An assignment a teacher posts to a whole class, each student's work on
    // it, the student's unsent draft, the grade as staff write it, and the
    // history of hand-ins (docs/plans/ASSIGNMENTS.md). Every write but one goes
    // through a callable, where the dates are checked against the institute's
    // clock; the one is a student typing the note on their own draft.
    match /coursework/{courseworkId} {
      allow get, list: if staffManagesCourse(resource.data.courseId);
      // A student reads an assignment only through their own work on it, the
      // way a recording is read through a grant — and never a draft one. GET
      // only, for the cost reason `/recordings` gives; the exists() guards the
      // usual case, which is absence.
      allow get: if isStudent()
        && resource.data.status == 'posted'
        && exists(/databases/$(database)/documents/submissions/$(request.auth.uid + '_' + courseworkId))
        && get(/databases/$(database)/documents/submissions/$(request.auth.uid + '_' + courseworkId)).data.active == true;
      allow write: if false;
    }

    // One student's work: what they handed in, their own dates, and the grade
    // once RETURNED — the only way a grade reaches a student.
    match /submissions/{submissionId} {
      // Own and absent reads as absent, as a grant does: an assignment deleted,
      // never posted or given in another class is "not available", not a
      // refused listener.
      allow get: if (isStudent()
          && (resource == null
                ? submissionId.split('_')[0] == request.auth.uid
                : resource.data.studentUid == request.auth.uid))
        || staffManagesCourse(resource.data.courseId);
      allow list: if (isStudent() && resource.data.studentUid == request.auth.uid)
        || staffManagesCourse(resource.data.courseId);
      allow write: if false;
    }

    // A student's unsent work. THEIRS ALONE: there is no staff arm, so nobody
    // sees work before it is handed in. The student writes the note; files
    // arrive through a callable, so a client may never touch `files`.
    match /drafts/{draftId} {
      function submissionPath(cwId) {
        return /databases/$(database)/documents/submissions/$(request.auth.uid + '_' + cwId);
      }
      // Open work, still theirs, in the class it was given in.
      function workIsOpen(cwId, courseId) {
        return exists(submissionPath(cwId))
          && get(submissionPath(cwId)).data.active == true
          && get(submissionPath(cwId)).data.state == 'open'
          && get(submissionPath(cwId)).data.courseId == courseId;
      }
      // MAX_ANSWER_CHARS in @sabeel/shared; rules.coursework.test.ts holds them together.
      function noteShape() {
        return request.resource.data.note is string
          && request.resource.data.note.size() <= 20000
          && isTime(request.resource.data.updatedAt);
      }
      allow get: if isStudent()
        && (resource == null
              ? draftId.split('_')[0] == request.auth.uid
              : resource.data.studentUid == request.auth.uid);
      allow list: if isStudent() && resource.data.studentUid == request.auth.uid;
      allow create: if isWritingStudent()
        && request.resource.data.studentUid == request.auth.uid
        && draftId == request.auth.uid + '_' + request.resource.data.courseworkId
        && request.resource.data.keys().hasOnly(
              ['studentUid', 'courseworkId', 'courseId', 'note', 'files', 'updatedAt'])
        && request.resource.data.files == {}
        && noteShape()
        && workIsOpen(request.resource.data.courseworkId, request.resource.data.courseId);
      // Typed over the answer as it is stored now: a save made offline over
      // an older answer arrives after the newer one and is refused, rather
      // than replacing what was written since on another device.
      allow update: if isWritingStudent()
        && resource.data.studentUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['note', 'updatedAt', 'basedOn'])
        && request.resource.data.basedOn == resource.data.updatedAt
        && noteShape()
        && workIsOpen(resource.data.courseworkId, resource.data.courseId);
      allow delete: if false;
    }

    // The grade as staff are writing it. NEVER student-readable: Firestore has
    // no field-level security, so a draft grade lives where no student rule
    // reaches, and is copied onto the submission when the work is returned.
    match /grades/{gradeId} {
      allow get, list: if staffManagesCourse(resource.data.courseId);
      allow write: if false;
    }

    // One assignment's figures, kept by the server: the course's staff read
    // them, and nobody else, as the work they count.
    match /courseworkTallies/{courseworkId} {
      allow get, list: if staffManagesCourse(resource.data.courseId);
      allow write: if false;
    }

    // Each hand-in and take-back, append-only, written by the callables.
    match /submissionEvents/{eventId} {
      allow get, list: if (isStudent() && resource.data.studentUid == request.auth.uid)
        || staffManagesCourse(resource.data.courseId);
      allow write: if false;
    }

    // ---- Completions ----
    // Document id is `${studentUid}_${recordingId}`. Current completion STATE,
    // client-written for the same reason as listeningProgress: marking complete must work OFFLINE, which a
    // callable cannot. The "never played" precondition is enforced in the app,
    // not here (planning decision #5): requiring the progress doc to exist would
    // false-reject a completion whose queued progress write has not yet synced.
    // Everything privilege-adjacent is still denied — self-only, no forging uid.
    match /completions/{completionId} {
      // Id bound to content, for the same reason as `listeningProgress` above:
      // otherwise one student can plant a row under another student's id and
      // lock them out of marking that recording complete, permanently.
      function mineC() {
        return isWritingStudent()
          && request.resource.data.studentUid == request.auth.uid
          && completionId == request.resource.data.studentUid + '_'
              + request.resource.data.recordingId;
      }
      // Shaped, for the reason `progressShape` gives: `completedAt` is
      // formatted on the ledger and in its export.
      function completionShape() {
        return request.resource.data.keys().hasOnly(
              ['studentUid', 'recordingId', 'courseId', 'completed', 'completedAt', 'updatedAt'])
          && request.resource.data.completed is bool
          && (request.resource.data.completedAt == null || isTime(request.resource.data.completedAt))
          && isTime(request.resource.data.updatedAt);
      }
      // Bound to the caller's own id, like `listeningProgress` above: an
      // unbound null arm would answer about any `${uid}_${recordingId}`.
      allow get: if (isStudent()
          && (resource == null
                ? completionId.split('_')[0] == request.auth.uid
                : resource.data.studentUid == request.auth.uid))
        || (resource != null && staffManagesCourse(resource.data.courseId));
      // Staff read the roster's completions for the recording/class ledger,
      // class-scoped.
      allow list: if (isStudent() && resource.data.studentUid == request.auth.uid)
        || staffManagesCourse(resource.data.courseId);
      // The class is the grant's, for the same reason as `listeningProgress`
      // above — this is the collection the ledger's completion column reads, so
      // a wrong `courseId` shows a student complete on their own home and not
      // complete to the manager chasing them. `get` on create only; an update
      // may not move it.
      allow create: if mineC() && completionShape()
        && holdsGrant(request.resource.data.recordingId)
        && request.resource.data.courseId == grantedCourse(request.resource.data.recordingId);
      allow update: if mineC() && completionShape()
        && resource.data.studentUid == request.auth.uid
        && request.resource.data.courseId == resource.data.courseId
        && holdsGrant(request.resource.data.recordingId);
      allow delete: if false;
    }

    // ---- Completion events ----
    // Append-only audit of every mark/unmark. A student may create their own and
    // read their own; nothing may update or delete one, so the history cannot be
    // rewritten. Staff reading is the Phase 5 ledger.
    match /completionEvents/{eventId} {
      // AUTO-IDS, so there is no id to bind — the shape has to be checked
      // instead. Unvalidated, this accepted any `courseId`, any `recordingId`
      // and any `action` from any student, and `update, delete: if false` makes
      // whatever lands permanent: a forged row in a class the writer is not in,
      // in the collection described here as the audit of every mark. Tying
      // `courseId` to the student's OWN assignment for that recording settles
      // both — the grant must exist, and the class is the grant's, not the
      // caller's to choose. One `get`, on a path the caller already knows.
      allow create: if isWritingStudent()
        && request.resource.data.keys().hasOnly(
             ['studentUid', 'recordingId', 'courseId', 'action', 'actor', 'at'])
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.actor == 'student'
        && request.resource.data.action in ['complete', 'uncomplete']
        && isTime(request.resource.data.at)
        && holdsGrant(request.resource.data.recordingId)
        && request.resource.data.courseId == grantedCourse(request.resource.data.recordingId);
      /*
       * NO NULL ARM HERE, unlike its neighbours — and the difference is the id.
       *
       * `listeningProgress`, `completions` and `completionOverrides` are keyed
       * `${studentUid}_${recordingId}`, so a null arm can be bound to the
       * caller's own id and answers only about their own row. These ids are
       * auto-generated: there is nothing to bind, so an "absent is readable" arm
       * would answer about anybody's, and nothing reads this collection by id in
       * the first place. A `list` always evaluates against real documents, so it
       * needs no guard.
       */
      allow get, list: if (isStudent() && resource.data.studentUid == request.auth.uid)
        || staffManagesCourse(resource.data.courseId);
      allow update, delete: if false;
    }

    // ---- Completion overrides ----
    // Document id is `${studentUid}_${recordingId}`. A staff override of a
    // student's completion, written ONLY by the server (the overrideCompletion
    // callable), so a student can never clobber it — the whole point of keeping
    // it out of the student-written completions doc. The student may READ their
    // own (the brief lets a student see their full accountability details);
    // staff read it scoped to their class for the ledger.
    match /completionOverrides/{overrideId} {
      /*
       * A NULL ARM BOUND TO THE CALLER'S OWN ID.
       *
       * Most students have no override on most recordings, so a get by id is
       * usually of a document that does not exist — and without a null arm that
       * is a rules evaluation error rather than an answer. But `resource == null`
       * on its own answers about ANY id, and these are `${uid}_${recordingId}`:
       * absent-is-allowed against present-is-denied would tell a student whether
       * staff had overridden a named classmate on a named recording. Binding the
       * id keeps the answer to their own row.
       */
      allow get: if (isStudent()
          && (resource == null
                ? overrideId.split('_')[0] == request.auth.uid
                : resource.data.studentUid == request.auth.uid))
        || (resource != null && staffManagesCourse(resource.data.courseId));
      allow list: if (isStudent() && resource.data.studentUid == request.auth.uid)
        || staffManagesCourse(resource.data.courseId);
      allow write: if false;
    }

    // ---- Audit log ----
    // Server-written only (the auditedCall wrapper + the auth trigger). Reads
    // are scoped like the rest of staff data: an admin sees everything; a manager
    // sees only entries tagged with a class they run. Course-less entries (cohort,
    // staff, student-directory changes) have courseId == null and are therefore
    // ADMIN-ONLY — which is exactly "managers manage audit within their courses".
    // The `courseId != null` guard also keeps a manager's list query constrained.
    match /auditLog/{entryId} {
      /*
       * AND WHAT THEY DID THEMSELVES, wherever it happened.
       *
       * A manager may create a student account without naming a course — which
       * is deliberate, teachers do intake — and that entry has `courseId: null`,
       * so the class-scoped arm above hid the most privilege-adjacent thing a
       * manager can do from the manager who did it. Reading your own actions
       * discloses nothing: you performed them. It is a zero-read arm, and a
       * query constrained by `actorUid == request.auth.uid` needs no class
       * lookup at all.
       */
      allow get, list: if isAdmin()
        || (isStaff() && resource.data.actorUid == request.auth.uid)
        || (isStaff() && resource.data.courseId != null
            && request.auth.uid in
               get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.managerUids);
      allow write: if false;
    }

    // ---- Notifications ----
    // Document id is the person's uid. Three things live under it, with three
    // different owners, which is why they are separate subcollections rather
    // than fields: the switches are theirs, the device tokens are theirs to add
    // and remove, and the record of what was already sent is the server's alone.
    match /notifications/{uid} {
      function isMine() {
        return isActive() && request.auth.uid == uid;
      }
      // A write also asks the person's record, as every other write of theirs
      // does: a token still holding its claims re-registered the device and
      // rewrote the switches of an account disabled, or deleted, minutes before.
      function isMineToWrite() {
        return isMine() && (role() == 'student' ? isWritingStudent() : staffRecordAgrees());
      }

      // Both populations write here — the first client-writable document staff
      // have. `students` and `staffUsers` deliberately refuse self-writes
      // because role and status ARE the security model; preferences are not
      // privilege-adjacent, so they get their own document rather than a field
      // on one whose every future field would need re-auditing.
      allow get: if isMine();
      // hasOnly on BOTH arms, and they cannot be merged: `resource` is null on a
      // create, so diff() against it is an evaluation error rather than a
      // denial. Whitelisting the keys is what stops this document quietly
      // becoming a place to store anything.
      allow create: if isMineToWrite()
        && request.resource.data.keys().hasOnly(
             ['recordingReady', 'lastDay', 'assignmentPosted', 'handInLastDay', 'workReturned',
              'attendanceMissing', 'updatedAt']);
      allow update: if isMineToWrite()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
             ['recordingReady', 'lastDay', 'assignmentPosted', 'handInLastDay', 'workReturned',
              'attendanceMissing', 'updatedAt']);
      allow delete: if false;

      // Keyed BY the token, so the send path can delete the exact row that
      // failed without a query.
      //
      // Re-registering the same device is a no-op in INTENT only — it rewrites
      // the row with a fresh registeredAt, which Firestore evaluates as an
      // UPDATE, not a create. Denying updates outright therefore denied the
      // second visit to the notification settings, and the screen reported a
      // registered, working device as unable to receive push. What stays
      // forbidden is editing a row into a DIFFERENT token, which is what the
      // id-must-match check refuses on both arms.
      match /devices/{token} {
        allow get, list, delete: if isMine();
        /*
         * `hasOnly`, like the preferences document above: this row is read by
         * the send path and ordered by a trigger, so a field nobody expects is a
         * field nobody validates.
         *
         * NOT BOUNDED AGAINST `request.time`, deliberately (only absolutely,
         * by `isTime`, which a fast clock passes). `registeredAt` is
         * the device's own `Date.now()` and nothing on the server reads it —
         * `onDeviceRegistered` orders by Firestore's `updateTime` precisely so a
         * client cannot buy that decision. A bound would therefore protect
         * nothing while refusing a phone whose clock runs fast, and the client
         * does not wait for this write, so that refusal is silent: the settings
         * screen would report a registered, working device whose push is dead.
         */
        /*
         * Two shapes. An Android phone or a browser holds an FCM token; an
         * iPhone holds Apple's, and says which of Apple's two services issued
         * it, because the send path must ask that one and the other refuses it
         * (functions/src/apns.ts). A platform outside these three is a row
         * nothing would ever deliver to.
         */
        allow create, update: if isMineToWrite()
          && request.resource.data.token == token
          && isTime(request.resource.data.registeredAt)
          && (
            (request.resource.data.keys().hasOnly(['token', 'platform', 'registeredAt'])
              && request.resource.data.platform in ['android', 'web'])
            || (request.resource.data.keys().hasOnly(['token', 'platform', 'apnsEnvironment', 'registeredAt'])
              && request.resource.data.platform == 'ios'
              && request.resource.data.apnsEnvironment in ['development', 'production'])
          );
      }

      // Server-only, both ways. This is the idempotency marker the send path
      // claims before sending; a client that could create one would silence its
      // own notifications, and a client that could read one learns nothing the
      // app ever asks.
      match /sent/{sentId} {
        allow read, write: if false;
      }
    }

    // ---- Config ----
    // `config/app` holds the oldest Android build allowed to run, and the app
    // reads it BEFORE anyone signs in — a build the institute has retired
    // should say so on its first screen, not after a sign-in the rules then
    // refuse. Readable by anyone: it is one integer, and a signed-out read is
    // the point. Written by nobody but the Admin SDK (`scripts/set-min-version.mjs`).
    match /config/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // ---- Everything else ----
    // The backend-stats collection stays denied until it is opened deliberately
    // with its consumer.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
