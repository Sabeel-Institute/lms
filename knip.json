{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.mjs"
      ],
      "project": [
        "scripts/**/*.mjs"
      ],
      "ignoreDependencies": [
        "firebase-admin",
        "@aws-sdk/client-s3"
      ]
    },
    "app": {
      "entry": [
        "App.tsx",
        "babel.config.js",
        "metro.config.js",
        "src/**/*.web.ts",
        "src/**/*.web.tsx",
        "public/firebase-messaging-sw.js"
      ],
      "project": [
        "**/*.{ts,tsx,js}"
      ],
      "ignoreDependencies": [
        "expo-updates",
        "@expo/metro-runtime",
        "expo-system-ui",
        "react-native-worklets"
      ]
    },
    "functions": {
      "entry": [
        "test/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts"
      ]
    },
    "cloudflare/media-copier": {
      "entry": [
        "test/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts"
      ],
      "ignoreDependencies": [
        "cloudflare"
      ]
    },
    "packages/shared": {
      "entry": [],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts"
      ]
    }
  },
  "ignoreBinaries": [
    "firebase"
  ],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  }
}
