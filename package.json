{
  "name": "sabeel-institute-lms",
  "version": "0.0.0",
  "private": true,
  "description": "Sabeel Institute LMS — attendance, class recordings, assignments and grades (Android, iOS and web from one Expo codebase, Firebase backend)",
  "workspaces": [
    "packages/*",
    "functions",
    "app",
    "cloudflare/media-copier"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "npm run build -w @sabeel/shared && sabeel-ci build-info",
    "lint": "eslint . && npm run check:version && npm run check:text",
    "pretypecheck": "npm run build -w @sabeel/shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "pretest": "npm run build -w @sabeel/shared",
    "test": "npm run test --workspaces --if-present",
    "test:emulator": "sabeel-ci test-emulator",
    "build": "npm run build -w @sabeel/shared && npm run build -w functions",
    "build:aab": "sabeel-ci build-aab",
    "knip": "knip",
    "check:version": "sabeel-ci check-version",
    "check:text": "sabeel-ci check-text-sources",
    "emulators:free": "sabeel-ci free-emulator-ports",
    "emulators": "sabeel-ci emulators",
    "test:e2e": "bash scripts/e2e-stack.sh web",
    "test:screens": "bash scripts/e2e-stack.sh screens",
    "test:e2e:push": "bash scripts/e2e-stack.sh push",
    "seed:emulators": "node scripts/seed-emulators.mjs",
    "smoke:prod": "node scripts/prod-smoke.mjs",
    "check:queries": "node scripts/check-query-shapes.mjs",
    "check:documents": "node scripts/check-documents.mjs",
    "check:push": "sabeel-ci check-push",
    "check:web-push": "sabeel-ci check-web-push",
    "check:ios": "sabeel-ci check-ios-config",
    "build:ios": "sabeel-ci build-ios",
    "students:report": "node scripts/students-report.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@sabeel-institute/ci-tools": "github:Sabeel-Institute/ci-tools#82700d281d555fa17791fd452046597a8d02c078",
    "@sabeel/shared": "*",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "knip": "^5.88.1",
    "playwright": "^1.64.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
