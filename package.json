{
  "name": "sabeel-institute-lms",
  "version": "0.0.0",
  "private": true,
  "description": "Sabeel Institute LMS \u2014 class recordings with in-app listening and a staff accountability ledger (Android + web from one Expo codebase, Firebase backend)",
  "workspaces": [
    "packages/*",
    "functions",
    "app"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "npm run build -w @sabeel/shared",
    "lint": "eslint . && npm run check:text",
    "pretypecheck": "npm run build -w @sabeel/shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "pretest": "npm run build -w @sabeel/shared",
    "test": "npm run test --workspaces --if-present",
    "test:emulator": "bash scripts/test-emulator.sh",
    "build": "npm run build -w @sabeel/shared && npm run build -w functions",
    "knip": "knip",
    "check:text": "node scripts/check-text-sources.mjs",
    "emulators:free": "bash scripts/free-emulator-ports.sh",
    "test:e2e": "node scripts/web-e2e.mjs",
    "test:screens": "bash scripts/screens-e2e.sh",
    "seed:emulators": "node scripts/seed-emulator-world.mjs",
    "smoke:prod": "node scripts/prod-smoke.mjs",
    "check:queries": "node scripts/check-query-shapes.mjs",
    "check:push": "node scripts/check-push.mjs",
    "students:report": "node scripts/students-report.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@sabeel/shared": "*",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "knip": "^5.88.1",
    "playwright": "^1.61.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.53.0"
  }
}
