<resources xmlns:tools="http://schemas.android.com/tools">
  <!-- Light, not DayNight: the app is a single light theme (docs/BRAND.md), and
       DayNight drew the native pieces — dialogs, the document picker's chrome,
       text inputs — dark on a phone in dark mode, against ivory screens. -->
  <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
    <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
    <item name="colorPrimary">@color/colorPrimary</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@android:color/transparent</item>
    <!-- Ivory behind the app too, as its screens are: the theme's own white
         showed for the second between the launch screen and the first one. -->
    <item name="android:windowBackground">@color/splashscreen_background</item>
  </style>
  <!-- The launch window, until MainActivity sets AppTheme. Its background, a
       single colour from AppTheme, is what Android 12 and later draw the
       launcher icon on and earlier versions show plain; a bitmap there is
       stretched to the window. -->
  <style name="Theme.App.SplashScreen" parent="AppTheme" />
</resources>