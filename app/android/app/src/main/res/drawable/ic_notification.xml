<?xml version="1.0" encoding="utf-8"?>
<!--
  The status-bar / shade icon for a push.

  Android draws a small icon from its ALPHA CHANNEL ONLY: every opaque pixel is
  painted flat in the tint colour and everything else is dropped. The launcher
  icon does not survive that — it is a full-bleed ivory square, so its silhouette
  is the whole square, which is why it rendered as a featureless blob before this
  existed (observed on a device, 2026-08-28).

  So this is a silhouette by construction: transparent ground, one opaque glyph.
  The glyph is the mortarboard from the app icon's badge, the part of the
  icon that still reads at 24dp; the calligraphy does not. Its geometry is the
  badge glyph's (Sabeel-Institute/brand, skills/sabeel-brand/tools/
  make-app-icons.py, kind "cap"), mapped from its -100..100 space onto the
  24dp viewport at 0.15, so its 11-unit tassel is a 1.65dp stroke.

  A vector rather than five PNGs: it stays crisp at every density, and it is the
  only form of this asset that is reviewable in a diff.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

  <!-- The board. -->
  <path
      android:fillColor="#FFFFFFFF"
      android:pathData="M2.7,10.275 L12.0,6.075 L21.3,10.275 L12.0,14.475 Z" />

  <!-- The cap beneath it. -->
  <path
      android:fillColor="#FFFFFFFF"
      android:pathData="M6.6,12.675 L6.6,16.275 C6.6,18.375 17.4,18.375 17.4,16.275 L17.4,12.675 L12.0,15.075 Z" />

  <!-- The tassel's cord and its end. -->
  <path
      android:fillColor="#00000000"
      android:strokeColor="#FFFFFFFF"
      android:strokeWidth="1.65"
      android:strokeLineCap="round"
      android:pathData="M19.2,11.175 L19.2,15.675" />
  <path
      android:fillColor="#FFFFFFFF"
      android:pathData="M18.15,16.875 a1.05,1.05 0 1,0 2.1,0 a1.05,1.05 0 1,0 -2.1,0" />
</vector>
