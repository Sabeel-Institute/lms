{
  "name": "@sabeel/app",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "node ../scripts/preflight-metro.mjs && expo start",
    "android": "node ../scripts/preflight-metro.mjs && EXPO_PUBLIC_COMMIT=$(git rev-parse --short HEAD) expo run:android",
    "web": "expo start --web",
    "web:export": "EXPO_PUBLIC_COMMIT=$(git rev-parse --short HEAD) expo export --platform web --output-dir dist-web --clear",
    "web:export:maps": "EXPO_PUBLIC_COMMIT=$(git rev-parse --short HEAD) expo export --platform web --output-dir dist-web --clear --source-maps",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@lexical/html": "0.52.0",
    "@lexical/link": "0.52.0",
    "@lexical/list": "0.52.0",
    "@lexical/markdown": "0.52.0",
    "@lexical/react": "0.52.0",
    "@lexical/utils": "0.52.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/slider": "5.2.1",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@sabeel/shared": "*",
    "@sentry/browser": "^10.37.0",
    "@sentry/react-native": "~7.11.0",
    "expo": "~57.0.30",
    "expo-application": "~57.0.3",
    "expo-build-properties": "~57.0.22",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.1",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "57.0.20",
    "expo-notifications": "~57.0.23",
    "expo-sharing": "~57.0.23",
    "expo-status-bar": "~57.0.0",
    "expo-video": "~57.0.5",
    "firebase": "^12.15.0",
    "lexical": "0.52.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.0",
    "react-native-enriched-html": "1.1.1",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@react-navigation/core": "7.24.0",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
