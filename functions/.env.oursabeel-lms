# Function parameters for the oursabeel-lms project. Not secrets: those live in
# Secret Manager (docs/SECRETS.md).

# Who push notifications go to. Empty is nobody: the live site is being
# bug-hunted, and Faisal asked that no one be notified while it is. After
# that, `staff` until switchover day, when this becomes `everyone`
# (docs/plans/SWITCHOVER.md). See functions/src/notifyAudience.ts.
NOTIFY_AUDIENCE=

# The media store: Cloudflare R2, account 2695af9675357bbe44e188b0414b850f.
# Keys are secrets (R2_READ_*, R2_WRITE_*), not here. See functions/src/mediaStore.ts.
MEDIA_S3_ENDPOINT=https://2695af9675357bbe44e188b0414b850f.r2.cloudflarestorage.com
MEDIA_BUCKET=oursabeel-lms-media

# The Zoom copier Worker (cloudflare/media-copier); its wrangler.jsonc names
# the same address as AUDIENCE.
MEDIA_COPIER_URL=https://media-copier.oursabeel.workers.dev

# Apple's push service, for iPhones (functions/src/apns.ts). The key itself is
# the secret APNS_KEY; these two are not secret: the team id is in every signed
# app, and the key id is useless without the key.
APNS_KEY_ID=X5R8FL94BC
APPLE_TEAM_ID=XRKWA4QRN9

# The service account the server signs as to send email from
# apps-noreply@oursabeel.com through domain-wide delegation (functions/src/mail.ts,
# functions/src/gmail.ts). An address, not a secret: only an account granted
# Token Creator on it can sign as it (docs/DEPLOY.md).
MAILER_SERVICE_ACCOUNT=report-mailer@oursabeel-lms.iam.gserviceaccount.com
