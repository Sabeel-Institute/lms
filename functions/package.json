{
  "name": "functions",
  "version": "0.0.0",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && node esbuild.config.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run --dir test/unit",
    "test:rules": "vitest run --dir test/integration --no-file-parallelism rules.",
    "test:integration": "vitest run --dir test/integration --no-file-parallelism --exclude '**/rules.*.test.ts'",
    "serve": "npm run build && firebase emulators:start --only functions"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/s3-request-presigner": "3.1152.0",
    "@sentry/node": "^11.8.0",
    "@tokenizer/range": "0.13.1",
    "file-type": "22.2.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.4.0",
    "google-auth-library": "^10.9.0",
    "music-metadata": "11.16.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "esbuild": "^0.28.2",
    "firebase": "^12.15.0",
    "vitest": "^4.1.11"
  }
}
