# Function parameters for the emulator's demo project. The functions emulator
# reads this file, and functions/test/setup.ts loads it into the in-process
# tests, so both run with the same values.

# The emulator notifies everyone, as the institute's project will after
# switchover. See functions/src/notifyAudience.ts.
NOTIFY_AUDIENCE=everyone

# The media store: SeaweedFS on this machine, standing in for Cloudflare R2
# (scripts/lib/media-store.mjs starts it with these identities). Throwaway
# credentials for a server bound to 127.0.0.1; production reads the R2 keys
# from Secret Manager instead. See functions/src/mediaStore.ts.
MEDIA_S3_ENDPOINT=http://127.0.0.1:61307
MEDIA_BUCKET=oursabeel-lms-media
LOCAL_MEDIA_READ_KEY_ID=local-media-read
LOCAL_MEDIA_READ_SECRET=local-media-read-secret-0000
LOCAL_MEDIA_WRITE_KEY_ID=local-media-write
LOCAL_MEDIA_WRITE_SECRET=local-media-write-secret-0000

# The Zoom copier Worker does not run under the emulator: tests drive the
# Zoom import with a fake client (zoom.integration.test.ts).
MEDIA_COPIER_URL=unavailable-in-emulator

# Apple's push service is not reached under the emulator: messaging.ts
# suppresses every send there, and apns.test.ts stands a local server in.
APNS_KEY_ID=unused-in-emulator
APPLE_TEAM_ID=unused-in-emulator

# No email leaves under the emulator: functions/src/mail.ts skips every send
# there, and gmail.test.ts stands a local server in for Google.
MAILER_SERVICE_ACCOUNT=unused-in-emulator
